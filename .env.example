# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Internal API (shared secret for pg_cron -> backend communication)
INTERNAL_API_KEY=generate-a-strong-random-key-here

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Health check concurrency
MAX_CONCURRENT_CHECKS=200

# SMTP (optional, for email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@apexwatch.dev

# App
APP_NAME=ApexWatch
APP_VERSION=1.0.0
DEBUG=false
