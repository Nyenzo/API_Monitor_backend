# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Internal API (shared secret for pg_cron -> backend communication)
INTERNAL_API_KEY=generate-a-strong-random-key-here

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Health check concurrency
MAX_CONCURRENT_CHECKS=200
MAX_CHECKS_PER_RUN=500

# SMTP (optional — for email alert notifications when monitors go down)
# Leave SMTP_HOST empty to disable email alerts. Auth emails (password reset etc.)
# are handled by Supabase and do not require SMTP configuration here.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=alerts@example.com

# Dedicated self-monitoring service account (optional)
# MONITOR_API_KEY=generate-a-long-random-secret
# MONITOR_EMAIL=monitor@internal.yourdomain.com
# MONITOR_PASSWORD=replace-with-strong-password

# App
APP_NAME=API Monitor
APP_VERSION=1.0.0
DEBUG=false
